<?xml version="1.0" encoding="utf-8"?>
<!-- The journal can grow past a headset screen, so the whole page scrolls. The journal is a
     plain TextView rather than a nested ScrollView: nesting two vertical scrollers makes the
     inner one nearly impossible to drag with a VR controller. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Title bar: app name on the left, installed build right-aligned. The version is
             filled in at runtime from BuildConfig so an operator holding the headset can
             read the build without ADB. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/server_url_label"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/server_url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/server_url_hint"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/save_and_connect" />

            <Button
                android:id="@+id/use_auto_discovery_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/use_auto_discovery" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connection_status_label"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_unknown"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"
            android:text="@string/device_identity_label"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/device_identity_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/device_identity_resolving"
            android:scrollHorizontally="false"
            android:breakStrategy="simple"
            android:textIsSelectable="true"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="32dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/configuration_section_label"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/configuration_apply_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <TableLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shrinkColumns="1">

                    <TableRow android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_marginEnd="12dp"
                            android:text="@string/configuration_group"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/configuration_group"
                            android:text="@string/configuration_group_unknown"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp" />
                    </TableRow>

                    <TableRow
                        android:id="@+id/configuration_deployment_row"
                        android:visibility="gone">

                        <TextView
                            android:layout_marginEnd="12dp"
                            android:text="@string/configuration_deployment"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/configuration_deployment"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp" />
                    </TableRow>
                </TableLayout>

                <Button
                    android:id="@+id/configuration_reapply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/configuration_reapply"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/permissions_section_label"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TableLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shrinkColumns="0">

                    <TableRow android:layout_marginBottom="6dp">

                        <TextView
                            android:minWidth="158dp"
                            android:layout_marginEnd="12dp"
                            android:text="@string/storage_permission_label"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/storage_permission_status"
                            android:minWidth="92dp"
                            android:gravity="end"
                            android:textSize="14sp" />
                    </TableRow>

                    <LinearLayout
                        android:id="@+id/storage_permission_action"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/storage_permission_hint"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/grant_storage_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/grant_all_files_access" />
                    </LinearLayout>

                    <TableRow>

                        <TextView
                            android:minWidth="158dp"
                            android:layout_marginEnd="12dp"
                            android:text="@string/wifi_location_permission_label"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/wifi_permission_summary"
                            android:minWidth="92dp"
                            android:gravity="end"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp" />
                    </TableRow>
                </TableLayout>

                <TextView
                    android:id="@+id/wifi_permission_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/wifi_location_permission_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/permission_details_toggle"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="12dp"
                    android:text="@string/permission_details_show"
                    android:textAllCaps="false"
                    android:textColor="?android:attr/textColorSecondary" />

                <LinearLayout
                    android:id="@+id/permission_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/wifi_precise_location_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/wifi_background_location_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/wifi_overlay_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/wifi_location_services_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/wifi_diagnostics_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/wifi_diagnostics_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/wifi_diagnostics_permission_missing"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/update_journal_label"
            android:textSize="14sp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/journal_refresh_button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/update_journal_refresh" />

            <Button
                android:id="@+id/journal_clear_button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/update_journal_clear" />
        </LinearLayout>

        <TextView
            android:id="@+id/journal_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
